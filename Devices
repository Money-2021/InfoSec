// List Compartment devices
public void infoSec_devices_list()
{
    SET_INFO();
    string sin = Environment.GetEnvironmentVariable("TestA");
    string userTokenPath = @"D:\Examples\Info\Token-" + sin + ".json";
    Fido.FidoProvider fp = new Fido.FidoProvider(userTokenPath);

    // Extract Function endpoint 
    Uri _baseUri = new Uri(fp.Audience());

    // Build funtion endpoint Uri
    HttpClient _httpClient = new HttpClient();
    string _relativeUrl = "api/Devices";
    Uri _uri = new Uri(_baseUri, _relativeUrl);
    _httpClient.BaseAddress = _baseUri;
    
    // Pass parameters using a Dictionary
    // Valid Actions L= List Device Sins , A = Request device authorisation token, D = Remove Device from SCI compartment
    var queryParams = new Dictionary<string, string?>
    {
        { "Action", "L" }
    };

    string completeUri = QueryHelpers.AddQueryString(_uri.ToString(), queryParams);
    // Add Device Jwtoken
    _httpClient.DefaultRequestHeaders.Add("x-token", fp.GetJwToken());
    HttpResponseMessage response = _httpClient.GetAsync(completeUri).Result;
    if (response.IsSuccessStatusCode)
    {
        // Download One Cipher protected shared secret (Medley vectors) bound to each devices..
        string json = response.Content.ReadAsStringAsync().Result;
        List<string> devices = System.Text.Json.JsonSerializer.Deserialize<List<string>>(json);
    }
    else
    {
        // fail
        string error = response.Content.ReadAsStringAsync().Result;
        throw new Exception(error);
    }

}
